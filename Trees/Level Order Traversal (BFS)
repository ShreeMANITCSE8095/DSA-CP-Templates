void func(TreeNode* root, vector<int>& ans){
  if(root== NULL){
    return;
  }

  queue<TreeNode*> q;
  q.push(root);
  while(!q.empty()){
    int size= q.size();
    while(size--){
      TreeNode* temp= q.front();
      q.pop();
      ans.push_back(temp->val);
      if(temp->left!= NULL){
        q.push(temp->left);
      }
      if(temp->right!= NULL){
        q.push(temp->right);
      }
    }
  }
}

vector<int> levelOrder(TreeNode* root){
  vector<int> ans;
  func(root, ans);
  return ans;
}
